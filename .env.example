# Copy to .env for local development. Never commit .env.

# ---- Browser (Vite) -----------------------------------------------------
# Supabase gives sign-in and cloud sync. Leave both empty to run in local
# mode, where data is stored in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: the .mpp converter server (backend/). MS Project XML import and
# all exports work without it.
VITE_MSPROJECT_BACKEND_URL=http://localhost:5050

# ---- Server only (Netlify Functions / backend) --------------------------
# These are read on the server and never sent to browsers. Do NOT prefix
# them with VITE_.

# Required to enable Claude.
ANTHROPIC_API_KEY=

# Optional tuning (defaults shown).
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low
# AI_RATE_LIMIT_PER_10_MIN=20
# AI_DAILY_LIMIT=200
# AI_FALLBACKS=on

# When Supabase is configured, only signed-in users can use Claude. Set to
# true to also allow people using "Continue without an account".
# AI_ALLOW_ANONYMOUS=false
